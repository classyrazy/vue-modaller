{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "~/*": ["src/VueModaller/*"]
    },
    "types": ["vue"]
  },
  "include": ["src/VueModaller/**/*.ts", "src/VueModaller/**/*.d.ts", "src/VueModaller/**/*.vue"],
  "exclude": ["node_modules", "dist", "src/VueModaller/**/__tests__/**", "src/VueModaller/**/*.test.ts"]
}