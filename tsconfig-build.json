{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": "./",
    "paths": {
      "~/*": ["src/VueModaller/*"]
    }
  },
  "include": ["src/VueModaller/**/*.ts", "src/VueModaller/**/*.d.ts", "src/VueModaller/**/*.vue"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
